# Secrets — the only thing deliberately kept out of the repo.
.env

# Python build/runtime artifacts. Regenerable with `uv sync`, and .venv holds
# 123 MB of platform-specific ARM64 binaries that would be useless to any other
# machine, so it stays out.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Third-party llama.cpp binaries (27 MB), re-fetched by scripts/serve_local.ps1.
.tools/

# macOS
.DS_Store
