# Copy to .env and fill in the keys you have. Missing keys only disable the
# corresponding registry entries; everything else keeps working.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama needs no real key; the client just requires a non-empty value.
# Set it to any placeholder to enable the local ollama-* registry entries.
OLLAMA_API_KEY=ollama
